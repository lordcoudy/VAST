# Nonsecret optional publication-owner capacity locator.
# The file must contain a current validated S3 operator guarantee and actual Q4 sizing.
VAST_S3_CAPACITY_ATTESTATION=artifacts/s3-capacity/operator-capacity.v1.json

# Destination: configs/artifact-storage.yaml (exact selected endpoint/bucket/prefix).
# WSL credentials: /home/<service-user>/.config/vast/s3/credentials.ini, profile vast-s3.
# Bootstrap from the protected Windows profile with scripts/setup_s3_credentials.ps1.
# Use --s3-credentials-file for an explicit external locator; do not put credentials here.
# Measurement children exclude AWS credentials, ambient profiles and profile locators.
