+        header=self.cold.HEADER.unpack(original[:80]);payload=80+sum(header[9:12])
+        regions=(('header',0,80),('text',80,payload),('payload',payload,payload+header[12]))
+        try:
+            expected=replay.packets(directory,admissions,source,run)
