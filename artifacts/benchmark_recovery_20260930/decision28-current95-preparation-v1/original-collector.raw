"""Collect current setup metadata only, after a real renewed stock closure/root grant."""
import hashlib,json,os,stat,subprocess,sys,time
from pathlib import Path
ROOT=Path('/home/s-a-balashov/work/vast-component-release-20260930-d27')
HERE=Path(__file__).resolve().parent
BINDING=HERE/'collection.bound.v1.json'
OUT=HERE/'current95-original-attempt01'
assert len(sys.argv)==3,'usage: collector ACTUAL_BINDING_SIZE ACTUAL_BINDING_SHA256'
BINDING_SIZE=int(sys.argv[1]);BINDING_SHA=sys.argv[2]
assert 0<BINDING_SIZE<=1048576 and len(BINDING_SHA)==64 and all(c in '0123456789abcdef' for c in BINDING_SHA)
START=time.monotonic();END=START+120
held=[];directories={};commands=[];first=None;close_errors=[];manifest=None
ROLE_PATHS={
 'capability_manifest_path':'artifacts/publication_policy_qualification_v2_fix_benchmark_20260928g/candidate/checkpoint_policy_capability_candidate_manifest.json',
 'calibration_path':'artifacts/publication_policy_qualification_v2_fix_benchmark_20260928g/bootstrap/checkpoint_policy_qualification_bootstrap_calibration.gstreamer_custom.v2.json',
 'model_parity_receipt_path':'configs/checkpoint_analytics_model_parity.refreshed.v4.fix-benchmark-20260928g.accepted.acceptance_receipt.json',
 'runtime_image_receipt_path':'artifacts/benchmark_recovery_20260930/selected-gstreamer-build-a4e145b7-v1/gstreamer_custom.runtime.freeze.json',
 'worker_freeze_receipt_path':'artifacts/fix_benchmark_preparations_20260928g/worker_images/analytics-worker.freeze.json',
 'execution_code_closure_path':'artifacts/gstreamer_component_release_20260930_a4e145b7/host/execution-code-closure.ext4-supervisor.v2.json'}
CONTROLLER=ROOT/'artifacts/benchmark_recovery_20260930/component-supervisor-renewal-preparation-v1/run_original_cpu_component_pair_ext4_supervisor_v2.py'
EXPECTED_CONTROLLER={'path':str(CONTROLLER),'size_bytes':15100,'sha256':'b4488d87a4c0feb500d7fdbca77af76e4745efeafb4927003ea1e932227ec8fd'}
EXPECTED_ROLE_SHA={
 'capability_manifest_path':'3c921a062345d571c836eed6e40de6b3bf4b7be798e24b792c10c1d1df3c1494',
 'calibration_path':'8f984df897f12f6269e68a2a1dda6ffe5fc112c5729f5f46fd9f7079bde96b15',
 'model_parity_receipt_path':'6f50d92e74ab7750f262d2697b0fceeb979d4f221eda90a0223cce4d5ff7a169',
 'runtime_image_receipt_path':'61874c718d6140d0d5cf745988bc301b916077af8f80e96742184f80a0805db7',
 'worker_freeze_receipt_path':'ff7dca7f25ffa9856cf0afdf97569e9ced3292866251e2523db00aa23875ef96'}
def clock():
 if time.monotonic()>=END:raise TimeoutError('current95 metadata collection120s')
def epoch(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
def identity(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_gid]
def ancestors(p):
 for q in reversed(p.parents):
  if q in directories:continue
  assert q.resolve(strict=True)==q
  fd=os.open(q,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
  s=os.fstat(fd)
  try:assert stat.S_ISDIR(s.st_mode) and identity(s)==identity(q.lstat())
  except BaseException:os.close(fd);raise
  directories[q]=(fd,identity(s))
def observe(fd,p):
 clock();s=os.fstat(fd);assert stat.S_ISREG(s.st_mode) and s.st_nlink==1 and 0<s.st_size<=16*1048576
 os.lseek(fd,0,os.SEEK_SET);h=hashlib.sha256();size=0
 while block:=os.read(fd,65536):clock();h.update(block);size+=len(block)
 assert size==s.st_size and epoch(s)==epoch(os.fstat(fd))==epoch(p.lstat()) and p.resolve(strict=True)==p
 return {'descriptor':{'path':str(p),'size_bytes':size,'sha256':h.hexdigest()},'epoch':epoch(s)}
def hold(p,expected=None):
 p=Path(p);assert p.is_absolute() and p.resolve(strict=True)==p
 assert p not in {x[1] for x in held},'current95/control duplicate path'
 ancestors(p);fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
 try:
  row=observe(fd,p)
  if expected is not None:assert row['descriptor']==expected,'current physical descriptor mismatch:'+str(p)
  held.append((fd,p,row));return row
 except BaseException:os.close(fd);raise
def owner(pid):
 p=Path('/proc',str(pid));v=(p/'stat').read_text().rsplit(')',1)[1].split();status=dict(x.split(':',1) for x in (p/'status').read_text().splitlines() if ':' in x)
 return {'pid':pid,'ppid':int(v[1]),'pgid':int(v[2]),'startticks':int(v[19]),'uid':int(status['Uid'].split()[0]),'gid':int(status['Gid'].split()[0]),'boot_id':Path('/proc/sys/kernel/random/boot_id').read_text().strip()}
def head(label):
 clock();argv=['/usr/bin/git','-c','core.longpaths=true','-C',str(ROOT),'rev-parse','HEAD']
 child=subprocess.Popen(argv,stdout=subprocess.PIPE,stderr=subprocess.PIPE,start_new_session=True)
 try:
  actual=owner(child.pid);stdout,stderr=child.communicate(timeout=max(.001,min(10,END-time.monotonic())))
 except BaseException:child.kill();child.wait(timeout=5);raise
 finally:
  for f in (child.stdout,child.stderr):
   if f is not None and not f.closed:f.close()
 assert child.returncode==0 and len(stdout)<=128 and stderr==b''
 commands.append({'label':label,'argv':argv,'owner':actual,'returncode':child.returncode,'reaped':True,'stdout_ascii':stdout.decode('ascii'),'stderr_hex':stderr.hex()})
 return stdout.decode('ascii').strip()
def save(name,value):
 raw=(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n').encode('ascii');assert len(raw)<=1048576
 with (OUT/name).open('xb') as f:assert f.write(raw)==len(raw);f.flush();os.fsync(f.fileno())
 return {'path':str(OUT/name),'size_bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest()}
try:
 assert os.getuid()==os.getgid()==1000 and sys.version_info[:3]==(3,12,3)
 assert ROOT.resolve(strict=True)==ROOT and identity(ROOT.lstat())[3:]==[1000,1000] and not OUT.exists()
 control=hold(BINDING,{'path':str(BINDING),'size_bytes':BINDING_SIZE,'sha256':BINDING_SHA})
 fd=held[0][0];os.lseek(fd,0,os.SEEK_SET);binding=json.loads(os.read(fd,BINDING_SIZE+1))
 assert set(binding)=={'schema_version','artifact_kind','source_commit','project_root','stock_closure_descriptor','current_controller_descriptor','role_descriptors'}
 assert binding['schema_version']==1 and binding['artifact_kind']=='vast_current95_collection_binding_v1' and binding['project_root']==str(ROOT)
 commit=binding['source_commit'];assert type(commit) is str and len(commit)==40 and all(c in '0123456789abcdef' for c in commit)
 assert set(binding['role_descriptors'])==set(ROLE_PATHS)
 for role,relative in ROLE_PATHS.items():
  assert binding['role_descriptors'][role]['path']==str(ROOT/relative)
  if role in EXPECTED_ROLE_SHA:assert binding['role_descriptors'][role]['sha256']==EXPECTED_ROLE_SHA[role]
 assert binding['stock_closure_descriptor']==binding['role_descriptors']['execution_code_closure_path']
 assert binding['current_controller_descriptor']==EXPECTED_CONTROLLER
 before_head=head('before');assert before_head==commit
 sys.path.insert(0,str(ROOT/'scripts'))
 from publication_policy_qualification_execution_code_closure_v1 import load_execution_code_closure_v1
 loaded=load_execution_code_closure_v1(project_root=ROOT,receipt_path=ROOT/ROLE_PATHS['execution_code_closure_path'])
 closure=loaded['receipt'];pin=loaded['receipt_descriptor']
 assert {**pin,'path':str(ROOT/pin['path'])}==binding['stock_closure_descriptor']
 sources=closure['project_sources'];assert len(sources)==len({r['path'] for r in sources})==87
 rows=[]
 for role in ROLE_PATHS:rows.append(hold(ROOT/ROLE_PATHS[role],binding['role_descriptors'][role]))
 snapshot_keys=('st_dev','st_ino','st_mode','st_nlink','st_size','st_mtime_ns','st_ctime_ns')
 for source in sources:
  relative=Path(source['path']);assert not relative.is_absolute() and '..' not in relative.parts
  row=hold(ROOT/relative,{k:source[k] for k in ('path','size_bytes','sha256')}|{'path':str(ROOT/relative)})
  assert row['epoch']==[source['snapshot'][k] for k in snapshot_keys];rows.append(row)
 interpreter=closure['interpreter'];assert Path(interpreter['path'])==Path(sys.executable).resolve(strict=True)
 row=hold(Path(interpreter['path']),{k:interpreter[k] for k in ('path','size_bytes','sha256')});assert row['epoch']==[interpreter['snapshot'][k] for k in snapshot_keys];rows.append(row)
 rows.append(hold(CONTROLLER,binding['current_controller_descriptor']))
 assert len(rows)==len({r['descriptor']['path'] for r in rows})==95 and sum(r['descriptor']['size_bytes'] for r in rows)<=64*1048576
 assert head('after')==before_head
 for fd,p,row in held:assert observe(fd,p)==row
 for p,(fd,before) in directories.items():assert identity(os.fstat(fd))==before==identity(p.lstat()) and p.resolve(strict=True)==p
 manifest={'schema_version':1,'artifact_kind':'vast_current_selected_setup95_metadata_v1','source_commit':commit,'project_root':str(ROOT),'fresh_stock_closure_descriptor':binding['stock_closure_descriptor'],'current_controller_descriptor':binding['current_controller_descriptor'],'role_paths':ROLE_PATHS,'composition':{'role_documents':6,'fresh_project_sources':87,'canonical_interpreter':1,'exact_current_controller':1,'unique_total':95},'actual_current95':rows,'all_collection_fds_released':True,'metadata_only_no_model_image_runtime_acceptance':True,'binding_descriptor':control['descriptor']}
except BaseException as exc:first={'type':type(exc).__name__,'message':str(exc)[:4096]}
finally:
 for fd in [x[0] for x in held]+[x[0] for x in directories.values()]:
  try:os.close(fd)
  except OSError as exc:close_errors.append({'type':type(exc).__name__,'errno':exc.errno})
 OUT.mkdir(mode=0o700)
 report={'schema_version':1,'status':'current95_collected' if first is None and not close_errors else 'failed_no_current95_grant','first_error':first,'close_errors':close_errors,'owner':owner(os.getpid()),'commands':commands,'held_input_count':len(held),'held_ancestor_count':len(directories),'all_collection_fds_released':not close_errors,'work_limit_s':120,'cleanup_s':10,'elapsed_before_final_report_s':time.monotonic()-START,'manifest':None}
 if first is None and not close_errors:
  clock();report['manifest']=save('current95-inputs.v1.json',manifest)
 ref=save('execution.v1.json',report)
late=time.monotonic()>=END
if late:save('late-failure.v1.json',{'closed_report':ref,'first_error':first,'elapsed_after_receipts_and_fdclose_s':time.monotonic()-START})
print(json.dumps({'report':ref,'manifest':report['manifest'],'late':late}),flush=True)
sys.exit(0 if first is None and not close_errors and not late else 1)
