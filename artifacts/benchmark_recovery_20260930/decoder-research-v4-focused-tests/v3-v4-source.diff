+def read_process_maps(pid):
+    with Path(f'/proc/{pid}/maps').open('rb') as file:
+        raw = file.read(CHANNEL_MAX + 1)
+    require(len(raw) <= CHANNEL_MAX, 'original process maps1MiB cap exceeded')
