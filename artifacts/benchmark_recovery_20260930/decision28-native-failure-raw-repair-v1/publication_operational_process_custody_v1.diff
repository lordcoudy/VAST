+def _write_failure_channel(capture, path, raw):
+    """Retain only actual failed-measurement bytes, including an empty channel."""
+    label = "immutable failed original measurement channel"
+    _require(type(raw) is bytes and len(raw) <= MAX_CAPTURE_BYTES, "failed original channel exceeds source bound")
+    if raw:
+        descriptor = capture.custody.write_exclusive(path, raw, label=label, mode=0o444)
+        descriptor["path"] = str(path)
+        validate_descriptor_v1(descriptor)
+        capture.inputs.read(descriptor, MAX_CAPTURE_BYTES)
+        return descriptor
+    # Shared publication descriptors intentionally require nonempty bytes.
+    # Only this nonauthorizing zero-byte channel uses the existing POSIX
+    # O_EXCL primitive and exact created-inode durability barrier.
+    relative = capture.custody._relative(path, label=label)
+    descriptor, identity = capture.custody._write_exclusive_posix(
+        relative, raw, label=label, mode=0o444, create_parents=False)
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    try:
+        info = os.fstat(fd)
+        _require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and info.st_size == 0
+            and stat.S_IMODE(info.st_mode) == 0o444 and (info.st_dev, info.st_ino) == identity
+            and info.st_uid == capture.controller["uid"] and info.st_gid == capture.controller["gid"]
+            and _epoch(info) == _epoch(_path(path).lstat()), "empty failed original channel custody drifted")
+        observed, observed_identity = capture.custody.adopt_exact_durable_identity(
+            path, raw, label=label, mode=0o444, expected_identity=identity, allow_empty=True)
+        _require(observed == descriptor and observed_identity == identity
+            and _epoch(os.fstat(fd)) == _epoch(info), "empty failed original channel durability drifted")
+        capture.empty_failure_channels.append((fd, path, _epoch(info)))
+        fd = -1
+    finally:
+        if fd >= 0:
+            os.close(fd)
+    descriptor["path"] = str(path)
+    return descriptor
+
