+        original_observations=self.decoded(directory/'observations.v1.json')
+        def check(observed,bookkeeping,sink,completed,positive):
+            rows=[dict(row) for row in original_rows]
+            next(row for row in rows if row['kind']=='source_transport_eof')['observed_monotonic_ns']=observed
+            next(row for row in rows if row['kind']=='decoder_sink_eos_observed')['observed_monotonic_ns']=sink
+            self.raw(directory/'events.jsonl',b''.join(self.cold.canonical(row)+b'\n' for row in rows))
+            self.replace_document(directory/'source-transport-eof.v1.json',observed_monotonic_ns=observed)
+            self.replace_document(directory/'decoder-drain-completed.v1.json',
+                source_eof_monotonic_ns=bookkeeping,actual_decoder_sink_eos_ns=sink,completed_monotonic_ns=completed)
+            self.replace_document(directory/'observations.v1.json',actual_decoder_sink_eos_ns=sink)
+            self.reseal_run_leaves(directory)
+            fresh=self.cold.Replay(self.project,self.repository,self.attempt,'research',self.S,self.P)
+            fresh.plan=self.plan;self.replays.append(fresh)
+            try:
+                if positive:
+                    actual,_=fresh.run(1,'front_gate','default',source,self.guest_owner)
+                    self.assertEqual(actual['actual_decoder_sink_eos_ns'],sink)
+                    self.assertEqual(actual['timings'],original_observations['timings'])
+                    self.assertEqual(fresh.source_eof_clock_joins,[dict(run=1,
+                        observed_source_eof_monotonic_ns=observed,
+                        drain_bookkeeping_source_eof_monotonic_ns=bookkeeping,
+                        actual_decoder_sink_eos_ns=sink,drain_completed_monotonic_ns=completed,
+                        completion_from_observed_eof_ns=completed-observed)])
+                    self.assertNotIn('source_eof_clock_joins',actual)
+                else:
+                    with self.assertRaisesRegex(self.cold.Refusal,'original startup/actualEOF/drain bounds'):
+                        fresh.run(1,'front_gate','default',source,self.guest_owner)
+                self.assertEqual(self.decoded(directory/'decoder-drain-completed.v1.json')['elapsed_from_source_eof_s'],1)
+                fresh.h.check(True)
+            finally:fresh.h.close()
+            self.assertEqual(fresh.h.close_errors,[])
+            self.assertEqual(len(list(Path('/proc/self/fd').iterdir())),self.fd_before)
