ARG BASE_IMAGE=vast/deepstream-native-probe:7.0
FROM ${BASE_IMAGE}

ARG EXPECTED_BASE_IMAGE_ID=sha256:277bb99b1b23b5b763332041703905242a1238c3faeb72533aa6045c9d2d7489
LABEL org.vast.analytics_worker.base_image_id="${EXPECTED_BASE_IMAGE_ID}"
LABEL org.vast.analytics_worker.engine="tensorrt_cuda"

USER root

RUN install -d -m 0755 /opt/vast/analytics /opt/vast/bin /opt/vast/lib

COPY scripts/analytics_execution_protocol.py /opt/vast/analytics/analytics_execution_protocol.py
COPY scripts/analytics_execution_worker.py /opt/vast/analytics/analytics_execution_worker.py
COPY deploy/analytics_execution/tensorrt_worker.py /opt/vast/bin/vast_tensorrt_worker
COPY deploy/analytics_execution/tensorrt_backend.cpp /tmp/vast_tensorrt_backend.cpp

RUN g++ -std=c++17 -O2 -fPIC -shared \
      /tmp/vast_tensorrt_backend.cpp \
      -I/usr/local/cuda/include \
      -L/usr/local/cuda/lib64 \
      -Wl,-z,relro,-z,now \
      -Wl,--no-undefined \
      -lnvinfer -lcudart -lcrypto \
      -o /opt/vast/lib/libvast_tensorrt_backend.so \
  && rm -f /tmp/vast_tensorrt_backend.cpp \
  && chmod 0555 /opt/vast/bin/vast_tensorrt_worker \
  && chmod 0444 \
      /opt/vast/analytics/analytics_execution_protocol.py \
      /opt/vast/analytics/analytics_execution_worker.py \
      /opt/vast/lib/libvast_tensorrt_backend.so

ENV PYTHONPATH=/opt/vast/analytics
ENV VAST_TENSORRT_BACKEND_LIBRARY=/opt/vast/lib/libvast_tensorrt_backend.so

ENTRYPOINT ["/opt/vast/bin/vast_tensorrt_worker"]
