ARG BASE_IMAGE=vast/deepstream-native-probe:7.0
ARG BUILD_IMAGE=vast/deepstream-native-probe:7.0
ARG SOURCE_DATE_EPOCH=0

FROM ${BUILD_IMAGE} AS worker_builder

ARG SOURCE_DATE_EPOCH
USER root

RUN install -d -m 0755 \
      /opt/vast/worker-root/opt/vast/analytics \
      /opt/vast/worker-root/opt/vast/bin \
      /opt/vast/worker-root/opt/vast/lib

COPY scripts/analytics_execution_protocol.py /opt/vast/worker-root/opt/vast/analytics/analytics_execution_protocol.py
COPY scripts/analytics_execution_worker.py /opt/vast/worker-root/opt/vast/analytics/analytics_execution_worker.py
COPY deploy/analytics_execution/tensorrt_worker.py /opt/vast/worker-root/opt/vast/bin/vast_tensorrt_worker
COPY deploy/analytics_execution/tensorrt_backend.cpp /tmp/vast_tensorrt_backend.cpp

RUN g++ -std=c++17 -O2 -fPIC -shared \
      /tmp/vast_tensorrt_backend.cpp \
      -I/usr/local/cuda/include \
      -L/usr/local/cuda/lib64 \
      -Wl,-z,relro,-z,now \
      -Wl,--no-undefined \
      -lnvinfer -lcudart -lcrypto \
      -o /opt/vast/worker-root/opt/vast/lib/libvast_tensorrt_backend.so \
  && chmod 0555 /opt/vast/worker-root/opt/vast/bin/vast_tensorrt_worker \
  && chmod 0444 \
      /opt/vast/worker-root/opt/vast/analytics/analytics_execution_protocol.py \
      /opt/vast/worker-root/opt/vast/analytics/analytics_execution_worker.py \
      /opt/vast/worker-root/opt/vast/lib/libvast_tensorrt_backend.so \
  && find /opt/vast/worker-root -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

FROM ${BASE_IMAGE}

ARG EXPECTED_BASE_IMAGE_ID=sha256:16d284eb311f04a95f148746f0dc5637d54d527cc42be9a6cced5fcf0240770c
ARG VAST_SOURCE_SET_SHA256
ARG VAST_DEPENDENCY_SET_SHA256
ARG VAST_BUILD_CONTEXT_SHA256
ARG VAST_BASE_IMAGE_ID
ARG VAST_BUILD_IMAGE_ID
LABEL org.vast.component="analytics-tensorrt-worker-publication-v3"
LABEL org.vast.analytics_worker.base_image_id="${EXPECTED_BASE_IMAGE_ID}"
LABEL org.vast.analytics_worker.engine="tensorrt_cuda"
LABEL org.vast.publication-image.source-set-sha256="${VAST_SOURCE_SET_SHA256}"
LABEL org.vast.publication-image.dependency-set-sha256="${VAST_DEPENDENCY_SET_SHA256}"
LABEL org.vast.publication-image.build-context-sha256="${VAST_BUILD_CONTEXT_SHA256}"
LABEL org.vast.publication-image.base-image-id="${VAST_BASE_IMAGE_ID}"
LABEL org.vast.publication-image.build-image-id="${VAST_BUILD_IMAGE_ID}"

USER root

COPY --from=worker_builder /opt/vast/worker-root/ /

ENV PYTHONPATH=/opt/vast/analytics
ENV VAST_TENSORRT_BACKEND_LIBRARY=/opt/vast/lib/libvast_tensorrt_backend.so

ENTRYPOINT ["/opt/vast/bin/vast_tensorrt_worker"]
